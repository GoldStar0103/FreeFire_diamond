# Secrets — provider API key, Conekta credentials, Meta tokens.
# Never commit these; they live in the environment or the host's .env.
.env
.env.*
!.env.example

# Phase 0 discovery output contains live product IDs, real costs and raw
# provider responses. Useful locally, not something to publish.
phase0/out/

node_modules/
dist/
build/
.next/
out/

# TypeScript incremental build cache — machine-specific, changes on every build.
*.tsbuildinfo

*.log
npm-debug.log*
.pnpm-debug.log*

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local test Postgres cluster (scripts/pg.mjs)
.pgdata/

# Uploads. Comprobantes are customer bank receipts and flyers are large
# binaries the client re-uploads through the panel — neither belongs in git.
# The real location is UPLOAD_DIR, which must be absolute; this covers the
# common local choice of putting it inside the repo.
.uploads/

# Personal Claude Code overrides. Team-wide settings belong in
# .claude/settings.json, which is committed.
.claude/settings.local.json
