# Copy to .env and fill in. Never commit .env — see .gitignore.

# ── database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=levelup
POSTGRES_PASSWORD=levelup_dev
POSTGRES_DB=levelup
POSTGRES_PORT=5432
DATABASE_URL=postgres://levelup:levelup_dev@localhost:5432/levelup

# ── provider: RecargasAmérica ─────────────────────────────────────────────────
# API key only. Never the panel password — that was leaked in chat and rotated.
RA_BASE_URL=https://panel.recargasamerica.com/api/v1
RA_API_KEY=
# Pause fulfilment and alert below this balance rather than failing paid orders
# one at a time. A single Mega Prime 48k order costs more than a small float.
RA_LOW_BALANCE_USD=100
# Delay between provider calls. Eight rapid 5,600 top-ups to one account may
# trip velocity checks at the provider or at Garena.
RA_INTER_CALL_DELAY_MS=1500
# How often the worker re-syncs the provider catalog (and once at startup).
# Follows provider id changes onto recipes and unsent orders, and alerts on
# price changes and broken catalogs — see docs/RUNBOOK.md. 0 switches it off
# entirely, startup included; only for freezing the catalog during an incident.
CATALOG_SYNC_INTERVAL_MS=3600000

# ── pricing ───────────────────────────────────────────────────────────────────
# Revenue is MXN and fixed monthly; cost is USD and floats. Reviewed, not live.
# Only used to show costs and margins in the panel — it never affects what a
# customer is charged. Like the payment details, this is a bootstrap: the owner
# sets it under Ajustes and that value wins.
FX_USD_MXN=18.50

# ── where customers send their money ──────────────────────────────────────────
# These are a BOOTSTRAP only. The real values live in the database and the owner
# edits them in the panel under Ajustes, because a bank account changing should
# not need a redeploy. Anything saved there wins over what is set here.
#
# Leave them blank and nothing breaks: the storefront shows "estamos
# actualizando nuestros datos de pago" with a WhatsApp button, the panel shows a
# red banner, and no order is created. That is deliberate — these used to
# default to empty strings, which rendered a blank account number to a customer
# who had just confirmed their ID and was reaching for their banking app.
PAY_BANK=
# 18 digits. The panel validates the check digit; this is not checked here.
PAY_CLABE=
PAY_HOLDER=
# Card or reference number for an OXXO deposit. Optional — blank hides the row.
PAY_OXXO=
# 16-digit debit card number, shown next to the CLABE. Optional — SPEI accepts
# either, and some customers find a card number faster to type in their app.
PAY_CARD_NUMBER=

# ── card payments: Stripe ─────────────────────────────────────────────────────
# Optional. Blank = checkout offers the manual transfer flow only, exactly as
# before. Set BOTH keys to add "Pagar con tarjeta" (Stripe hosted Checkout).
#
# Stripe dashboard → Developers → API keys. Use sk_test_… until a real $10
# order has gone through end to end, then swap for sk_live_… and the live
# webhook secret together — a test key with a live secret verifies nothing.
STRIPE_SECRET_KEY=
# Developers → Webhooks → Add endpoint:
#   https://levelupstore.mx/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
# Then reveal the endpoint's "Signing secret" (whsec_…) and paste it here.
STRIPE_WEBHOOK_SECRET=
# Also offer cash at OXXO through Stripe. Turn OXXO on in the Stripe dashboard
# (Settings → Payment methods) FIRST — with it off there, every checkout fails.
STRIPE_OXXO=false
# Days an OXXO voucher stays payable (1–7).
STRIPE_OXXO_DAYS=2
# Also offer automatic SPEI bank transfer through Stripe (customer_balance /
# mx_bank_transfer). Turn "Transferencias bancarias" on in the Stripe
# dashboard (Settings → Payment methods) FIRST, same as OXXO above.
STRIPE_SPEI=false
# Days our own payment deadline is extended once a SPEI reference is issued
# (1–7). Stripe puts no fixed expiry on the transfer itself; this is just how
# long we wait before the sweep retires an order nobody has paid yet.
STRIPE_SPEI_DAYS=3
# Minutes a customer has to finish the Stripe page (30–1440). An abandoned
# checkout holds a Mega Oferta slot until then.
STRIPE_SESSION_MINUTES=60

# ── payments: Mercado Pago (OXXO and/or SPEI) ─────────────────────────────────
# Card always stays on Stripe above. OXXO and/or SPEI move here independently
# when Stripe's own settlement for that method (via PPRO) proves unreliable —
# each is its own flag below so either can be reverted to Stripe on its own,
# with no code change, if Mercado Pago ever turns out no better.
#
# Your Integrations (not the regular Developers menu) → your app → Credentials
# → Production credentials.
MERCADOPAGO_ACCESS_TOKEN=
# Same app → Webhooks → configure
#   https://levelupstore.mx/api/webhooks/mercadopago
# Events: "Pagos (legacy)" and "Órdenes comerciales". Then copy the webhook's
# own "Clave secreta" (Secret Signature), not the access token again.
MERCADOPAGO_WEBHOOK_SECRET=
# Offer cash at OXXO through Mercado Pago instead of Stripe.
MERCADOPAGO_OXXO=false
# Offer automatic SPEI bank transfer through Mercado Pago instead of Stripe.
MERCADOPAGO_SPEI=false
# Days our own payment deadline is extended once an OXXO ticket or SPEI
# reference is issued (1–30). Mercado Pago's own guidance recommends 3 days
# for SPEI specifically, to avoid the reference expiring right as a transfer
# is crediting; OXXO's expiry is read off the Payment directly and needs no
# separate setting here.
MERCADOPAGO_PENDING_DAYS=3

# ── tracking: Meta Pixel + Conversions API ────────────────────────────────────
# Events Manager → Data sources → the pixel. The ID is the long number. Blank =
# no Pixel on the site and nothing sent to Meta.
META_PIXEL_ID=
# Events Manager → the pixel → Settings → Conversions API → Generate access
# token. Secret — the worker uses it to report paid orders server-side. Blank =
# browser Pixel only.
META_CAPI_ACCESS_TOKEN=
# Events Manager → Test events. Paste the code while checking the setup, place
# a test order, confirm it appears there, then clear this. Left set, real
# purchases are reported as test events and never count.
META_CAPI_TEST_EVENT_CODE=

# TikTok Pixel — browser side only. Most of the traffic is TikTok, so this is
# the one to set first. TikTok Ads Manager → Tools → Events → Web events → the
# pixel. The ID is the code of capital letters and digits under its name (about
# 20 characters, e.g. C4ABC…), not the numeric ad account ID. Blank, or anything
# that is not capital letters and digits, = no TikTok Pixel on the site.
TIKTOK_PIXEL_ID=
# Reserved for TikTok's server-side Events API, which is NOT built yet. Nothing
# reads this; setting it changes nothing. Purchases reach TikTok only through
# the browser Pixel, so iOS and ad blockers will under-count them.
TIKTOK_ACCESS_TOKEN=

# ── legal identity ────────────────────────────────────────────────────────────
# Printed verbatim on /legal/privacidad and /legal/terminos. Not secret — the
# LFPDPPP requires the responsable's name, domicilio and contact to be public —
# but it is configuration, because a privacy notice naming the wrong entity is
# worse than none. Anything left blank renders as [PENDIENTE: …] on the page.
#
# The RFC below is 13 characters, which is the persona física format (RA·Ramírez
# M·Mojica M·Manuel — SAT skips "José"). A registered company would have 12. So
# "LevelUp Store México" is the nombre comercial and the responsable is the
# individual; the pages are worded that way. If the client does register a
# persona moral, swap LEGAL_ENTITY_NAME and re-check the RFC.
LEGAL_BUSINESS_NAME=LevelUp Store México
LEGAL_ENTITY_NAME=José Manuel Ramírez Mojica
LEGAL_RFC=RAMM051014D11
LEGAL_ADDRESS=Carretera Teloloapan - Apaxtla Km. 1, Col. El Pedregal, Teloloapan, Guerrero, C.P. 40400
LEGAL_CONTACT_EMAIL=contactolevelupmexico@gmail.com
# Used in the notices and in canonical URLs. Update once the domain is bought.
PUBLIC_DOMAIN=levelupstore.mx
# Google Search Console HTML-tag token (the `content=` value, not the whole
# meta tag). Blank = no verification tag. Search Console → Add property →
# URL prefix https://levelupstore.mx → HTML tag. After it verifies, add
# contactolevelupmexico@gmail.com as an owner and submit /sitemap.xml.
GOOGLE_SITE_VERIFICATION=
# Meta Business Manager → Brand Safety → Domains → HTML meta tag. The
# `content=` value only. Blank = no facebook-domain-verification tag.
# Facebook will not verify the domain if this is missing from <head>.
FACEBOOK_DOMAIN_VERIFICATION=

# ── deployment ────────────────────────────────────────────────────────────────
# Read by docker-compose.prod.yml and the Caddyfile. The panel gets its own
# hostname rather than a path on the storefront, so a routing mistake in the
# store can never expose it and it can be IP-restricted separately later.
ADMIN_DOMAIN=panel.levelupstore.mx
# Signs the admin panel's session cookies. Required — the panel refuses to
# start without one at least 32 characters long, rather than silently
# accepting forged cookies. Long and random; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Where Let's Encrypt sends expiry warnings. Use a mailbox somebody reads.
TLS_EMAIL=contactolevelupmexico@gmail.com

# The worker has no port to probe, so it touches this file and the container
# healthcheck reads its age. That is what distinguishes a dead worker from one
# that is running but wedged — which looks fine to anything that only checks
# whether the process exists, while paid orders pile up unfulfilled.
WORKER_HEARTBEAT_FILE=/var/run/levelup/heartbeat
WORKER_HEARTBEAT_MAX_AGE_MS=60000

# ── backups ───────────────────────────────────────────────────────────────────
# Read by scripts/backup.sh, which root's cron runs nightly from /srv/levelup —
# see docs/RUNBOOK.md §3. The apps ignore these.
#
# Days to keep the local copies in /srv/levelup/backups.
BACKUP_KEEP_DAYS=14
# Off-box copy: an rclone remote and folder, e.g. gdrive:levelup-backups or
# r2:levelup-backups. Blank = backups exist only on the server's own disk,
# which survives nothing that destroys that disk. The remote and its login are
# set up once with `sudo rclone config` and live in root's rclone.conf — never
# here (the R2_* variables further down are for uploads storage, not backups).
# A failed upload makes the nightly job report FAILED; the local copy is kept
# either way.
BACKUP_RCLONE_REMOTE=
# Days to keep copies on the remote. Longer than the local 14 on purpose: the
# remote is what is left when the server is gone, or when a problem went
# unnoticed for a couple of weeks. Each night uploads a full set, so the remote
# needs room for this many nights of backups (docs/RUNBOOK.md §3).
BACKUP_REMOTE_RETENTION_DAYS=30

# ── support ───────────────────────────────────────────────────────────────────
# Deliberately not a floating button — footer and failed orders only.
WHATSAPP_SUPPORT_NUMBER=522206161171
# Shown on a completed order, and only there: the invite is the thank-you for
# having bought, not a banner for people who have not. Blank hides the block.
WHATSAPP_VIP_GROUP_URL=
# Site-wide "join our community" popup, shown once per visitor per day. A
# WhatsApp CHANNEL invite (whatsapp.com/channel/...), not the group invite
# above — copy it from WhatsApp: the channel -> ⋮ -> Invitar por enlace.
# Blank hides the popup entirely.
WHATSAPP_CHANNEL_URL=https://chat.whatsapp.com/G36Z7hKEOVSJ4PYoT39lXR

# ── ops alerts ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
SENTRY_DSN=

# ── storage (flyers, comprobantes) ────────────────────────────────────────────
# Where uploads land. Both apps need the SAME directory mounted: the storefront
# writes comprobantes and serves flyers, the panel writes flyers and reads
# comprobantes back. It must sit outside any web root — a comprobante shows a
# name, a bank account and an amount, and only leaves through an authenticated
# route. Flyers are public and go out through /media/flyers/… instead.
#
# MUST be absolute. A relative path resolves against each process's working
# directory, so the panel would write to apps/admin and the storefront read
# from apps/web — an upload that reports success and shows a broken image. The
# apps refuse to start on a relative value rather than let that happen.
UPLOAD_DIR=/srv/levelup/uploads

# Not wired up yet. A single VPS with a mounted volume is the launch plan;
# these are here for when uploads outgrow it. `flyerUrl` already passes an
# absolute https value straight through, so that move is a data migration.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
