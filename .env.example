# Copy to .env and fill in. Never commit .env — see .gitignore.

# ── database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=levelup
POSTGRES_PASSWORD=levelup_dev
POSTGRES_DB=levelup
POSTGRES_PORT=5432
DATABASE_URL=postgres://levelup:levelup_dev@localhost:5432/levelup

# ── provider: RecargasAmérica ─────────────────────────────────────────────────
# API key only. Never the panel password — that was leaked in chat and rotated.
RA_BASE_URL=https://panel.recargasamerica.com/api/v1
RA_API_KEY=
# Pause fulfilment and alert below this balance rather than failing paid orders
# one at a time. A single Mega Prime 48k order costs more than a small float.
RA_LOW_BALANCE_USD=100
# Delay between provider calls. Eight rapid 5,600 top-ups to one account may
# trip velocity checks at the provider or at Garena.
RA_INTER_CALL_DELAY_MS=1500

# ── pricing ───────────────────────────────────────────────────────────────────
# Revenue is MXN and fixed monthly; cost is USD and floats. Reviewed, not live.
FX_USD_MXN=18.50

# ── payments ──────────────────────────────────────────────────────────────────
# Launch runs on the manual comprobante flow the client already uses, so Conekta
# is not on the critical path. Fill these when the account clears validation.
CONEKTA_PRIVATE_KEY=
CONEKTA_PUBLIC_KEY=
CONEKTA_WEBHOOK_SECRET=

# ── tracking ──────────────────────────────────────────────────────────────────
# Meta closed their accounts; the BM is being rebuilt. Adapters ship regardless.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# ── legal identity ────────────────────────────────────────────────────────────
# Printed verbatim on /legal/privacidad and /legal/terminos. Not secret — the
# LFPDPPP requires the responsable's name, domicilio and contact to be public —
# but it is configuration, because a privacy notice naming the wrong entity is
# worse than none. Anything left blank renders as [PENDIENTE: …] on the page.
#
# The RFC below is 13 characters, which is the persona física format (RA·Ramírez
# M·Mojica M·Manuel — SAT skips "José"). A registered company would have 12. So
# "LevelUp Store México" is the nombre comercial and the responsable is the
# individual; the pages are worded that way. If the client does register a
# persona moral, swap LEGAL_ENTITY_NAME and re-check the RFC.
LEGAL_BUSINESS_NAME=LevelUp Store México
LEGAL_ENTITY_NAME=José Manuel Ramírez Mojica
LEGAL_RFC=RAMM051014D11
LEGAL_ADDRESS=Carretera Teloloapan - Apaxtla Km. 1, Col. El Pedregal, Teloloapan, Guerrero, C.P. 40400
LEGAL_CONTACT_EMAIL=contactolevelupmexico@gmail.com
# Used in the notices and in canonical URLs. Update once the domain is bought.
PUBLIC_DOMAIN=levelupstore.mx

# ── support ───────────────────────────────────────────────────────────────────
# Deliberately not a floating button — footer and failed orders only.
WHATSAPP_SUPPORT_NUMBER=522206161171
# Shown on a completed order, and only there: the invite is the thank-you for
# having bought, not a banner for people who have not. Blank hides the block.
WHATSAPP_VIP_GROUP_URL=https://chat.whatsapp.com/G36Z7hKEOVSJ4PYoT39lXR

# ── ops alerts ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
SENTRY_DSN=

# ── storage (flyers, comprobantes) ────────────────────────────────────────────
# Where uploads land. Both apps need the SAME directory mounted: the storefront
# writes comprobantes and serves flyers, the panel writes flyers and reads
# comprobantes back. It must sit outside any web root — a comprobante shows a
# name, a bank account and an amount, and only leaves through an authenticated
# route. Flyers are public and go out through /media/flyers/… instead.
#
# MUST be absolute. A relative path resolves against each process's working
# directory, so the panel would write to apps/admin and the storefront read
# from apps/web — an upload that reports success and shows a broken image. The
# apps refuse to start on a relative value rather than let that happen.
UPLOAD_DIR=/srv/levelup/uploads

# Not wired up yet. A single VPS with a mounted volume is the launch plan;
# these are here for when uploads outgrow it. `flyerUrl` already passes an
# absolute https value straight through, so that move is a data migration.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
