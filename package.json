{
  "name": "levelup-store",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:generate": "pnpm --filter @levelup/db generate",
    "db:migrate": "pnpm --filter @levelup/db migrate",
    "db:seed": "pnpm --filter @levelup/db seed",
    "db:studio": "pnpm --filter @levelup/db studio",
    "phase0": "node phase0/discover.mjs",
    "pg:start": "node scripts/pg.mjs start",
    "pg:stop": "node scripts/pg.mjs stop",
    "pg:status": "node scripts/pg.mjs status",
    "typecheck": "pnpm --filter \"@levelup/*\" typecheck",
    "test": "pnpm --filter \"@levelup/*\" test",
    "worker": "pnpm --filter @levelup/worker start",
    "worker:dev": "pnpm --filter @levelup/worker dev",
    "up": "docker compose up -d",
    "down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
